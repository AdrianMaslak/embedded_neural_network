# generated by pblock_gen.tcl: lower four clock regions X0Y0..X1Y1
create_pblock pblock_rp
add_cells_to_pblock [get_pblocks pblock_rp] [get_cells -quiet [list system_i/rp_nn]]
resize_pblock [get_pblocks pblock_rp] -add {SLICE_X0Y0:SLICE_X113Y99 RAMB18_X0Y0:RAMB18_X5Y39 RAMB36_X0Y0:RAMB36_X5Y19 DSP48_X0Y0:DSP48_X4Y39}
set_property SNAPPING_MODE ON [get_pblocks pblock_rp]
set_property RESET_AFTER_RECONFIG true [get_pblocks pblock_rp]
