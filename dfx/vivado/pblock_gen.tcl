# Called by build_dfx.tcl before implementation: synthesize, then write pblock.xdc with
# explicit SLICE/RAMB/DSP ranges covering the lower four clock regions (X0Y0..X1Y1).
launch_runs synth_1 -jobs $jobs
wait_on_run synth_1
open_run synth_1 -name synth_for_pblock
set regs [get_clock_regions {X0Y0 X1Y0 X0Y1 X1Y1}]
set ranges {}
foreach t {SLICE RAMB18 RAMB36 DSP48} {
    set xs {}; set ys {}
    foreach s [get_sites -quiet -of_objects $regs -filter "NAME =~ ${t}_X*"] {
        if {[regexp "^${t}_X(\\d+)Y(\\d+)\$" $s -> x y]} { lappend xs $x; lappend ys $y }
    }
    if {[llength $xs] == 0} { continue }
    set xs [lsort -integer $xs]; set ys [lsort -integer $ys]
    lappend ranges "${t}_X[lindex $xs 0]Y[lindex $ys 0]:${t}_X[lindex $xs end]Y[lindex $ys end]"
}
puts "PBLOCK RANGES: $ranges"
close_design
set fh [open [file join $here pblock.xdc] w]
puts $fh "# generated by pblock_gen.tcl: lower four clock regions X0Y0..X1Y1"
puts $fh "create_pblock pblock_rp"
puts $fh "add_cells_to_pblock \[get_pblocks pblock_rp\] \[get_cells -quiet \[list system_i/rp_nn\]\]"
puts $fh "resize_pblock \[get_pblocks pblock_rp\] -add {$ranges}"
puts $fh "set_property SNAPPING_MODE ON \[get_pblocks pblock_rp\]"
puts $fh "set_property RESET_AFTER_RECONFIG true \[get_pblocks pblock_rp\]"
close $fh
