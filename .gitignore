# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/

# ---- dataset: train/val are regenerated by gen_shapes.py (fixed seeds) ----
dataset/train/
dataset/val/

# ---- Vitis HLS: projects and logs are regenerated by run_hls.tcl ----
hls/*/*_prj/
hls/cnn/cnn_csim/
hls/*/logs/
*.backup.log

# ---- Vivado: project is regenerated by build.tcl; vivado/out/ is kept ----
vivado/build/
vivado/.Xil/
vivado/NA/
vivado/*.log
vivado/*.jou
vivado/nlviewcommon.logfile
.Xil/
*.jou
*.str

# ---- Vitis firmware workspace: regenerated by build_sw.py ----
firmware/ws/
firmware/*.log
_ide/
.wsdata/

# ---- PC app results: only the reference board run is kept ----
pc/results/*
!pc/results/both_20261116_193730/

# ---- LaTeX build files ----
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
report/build.log

# ---- tools ----
tools/*.exe

# ---- course material and OS files ----
Assig 2.pdf
Thumbs.db
desktop.ini
.DS_Store

# ---- DFX bonus: build products are regenerated, dfx/vivado/out/ is kept ----
dfx/hls/*_prj/
dfx/vivado/build/
dfx/vivado/NA/
dfx/vivado/hd_visual/
dfx/firmware/ws/
dfx/*.txt
dfx/**/*.log
!dfx/results/*.log
